OPENAI_API_KEY=<your-openai-api-key>
LINE_CHANNEL_ACCESS_TOKEN=<your-line-channel-access-token>
LINE_CHANNEL_SECRET=<your-line-channel-secret>

# Supabase（App 可用 pooler :5432）
DATABASE_URL=postgresql+asyncpg://postgres.<your-project-ref>:<your-password>@<your-region>.pooler.supabase.com:5432/postgres?ssl=require
# Alembic / provision-stores：未設 DIRECT 時會自動把 :5432 改為 transaction pooler :6543
DATABASE_ALEM_DIRECT_URL=postgresql+psycopg2://postgres.<your-project-ref>:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_ALEM_URL=postgresql+psycopg2://postgres.<your-project-ref>:<your-password>@<your-region>.pooler.supabase.com:5432/postgres?sslmode=require
# 選填；provision-stores 直連 async（多數本機需 Supabase IPv4 add-on 才能連 db.<ref>.supabase.co）
# DATABASE_DIRECT_URL=

# Supabase Auth（驗證前端登入帶來的 token；見 Project Settings → API）
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>
# Supabase Storage（聊天圖片上傳；僅後端使用，勿提交到版控）
# 選填：未設時後端會用 SUPABASE_JWT_SECRET 簽出 service_role JWT
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# 選填；預設 chat-images（須為 public bucket，執行 scripts/ensure_chat_images_bucket.py 建立）
SUPABASE_STORAGE_BUCKET=chat-images

# 僅在本機不用 Docker、且要連 docker 舊版 db 容器時才需要
# POSTGRES_DB=flower
# POSTGRES_USER=flower
# POSTGRES_PASSWORD=flower
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5434

# Legacy；聊天圖片已改存 Supabase Storage，一般無需設定
# PUBLIC_BASE_URL=http://localhost:8000

# Redis（聊天即時推播 pub/sub；Docker 預設 redis://redis:6379/0）
REDIS_URL=YOUR_REDIS_URL

# Google Calendar 整合（店主授權後同步訂單到自己的 Google 日曆）
# 在 Google Cloud Console 啟用 Google Calendar API、建立 OAuth 2.0 Web 用戶端，
# 並把 redirect URI 設為下方 GOOGLE_OAUTH_REDIRECT_URI。
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/google/calendar/callback
# 加密 refresh token 的 Fernet 金鑰：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=<your-fernet-key>
# callback 完成後導回前端的網址
FRONTEND_BASE_URL=http://localhost:5173
